# PackIntel frontend environment. Copy to frontend/.env.local and fill in values.
# Only values prefixed NEXT_PUBLIC_ reach the browser; never put secrets here.

# Supabase project URL and public (anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API base URL for the OCR scanning pipeline.
# Local dev:  http://localhost:8000
# Production: https://packintel-backend.onrender.com
NEXT_PUBLIC_API_URL=https://packintel-backend.onrender.com

# Supabase service-role key. Server-side only.
# Required for inspector authorization, one-time-code login, and administrator
# account management (approve / reject / suspend / reactivate). Never prefix
# with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Demo-only: surface the one-time login code in the API response so it can be
# shown on the login screen. There is no SMS/email gateway in the SIH build.
# Leave unset (or false) in any real deployment.
DEMO_SHOW_OTP=false

# Pre-authorized demo inspector (run scripts/seed-demo-inspector.mjs).
# DEMO_INSPECTOR_PASSWORD enables Inspector ID + password login for the demo
# account. Never commit a real value; this is a demo credential only.
DEMO_INSPECTOR_ID=DEMO-INS-001
DEMO_INSPECTOR_NAME=Demo Legal Metrology Inspector
DEMO_INSPECTOR_PASSWORD=

# Optional administrator bootstrap allowlist. An account whose stored email
# matches this address is treated as an administrator even before its role is
# promoted to 'admin'. Leave unset once a real admin row exists.
ADMIN_VERIFICATION_EMAIL=
