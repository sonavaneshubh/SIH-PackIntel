# PackIntel frontend environment. Copy to frontend/.env.local and fill in values.
# Only values prefixed NEXT_PUBLIC_ reach the browser; never put secrets here.

# Supabase project URL and public (anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API base URL for the OCR scanning pipeline.
# Local dev:  http://127.0.0.1:5055
# Production: https://packintel-backend.onrender.com
NEXT_PUBLIC_API_URL=https://packintel-backend.onrender.com

# Inspector email-to-admin approval workflow.
# Server-only values. Never prefix these with NEXT_PUBLIC_ and never commit
# real credentials.

# Base URL used to build absolute verification links in admin emails.
# Leave unset to auto-detect from the incoming request.
APP_URL=http://localhost:3000

# Supabase service-role key. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Recipient for new inspector registration notification emails.
ADMIN_VERIFICATION_EMAIL=

# From address for PackIntel emails.
EMAIL_FROM=

# Resend API key for transactional email delivery.
RESEND_API_KEY=
