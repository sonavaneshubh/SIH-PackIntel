SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:3000
# Optional on Windows when Tesseract is not available in PATH.
TESSERACT_CMD=
# Multimodal vision extraction (Gemini 3.6 Flash). Keys are never exposed
# to the frontend. Falls back to raw OCR output when the API call fails.
VISION_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
VISION_API_KEY=
VISION_MODEL=gemini-3.6-flash
VISION_TIMEOUT_SECONDS=30
# Master switch for the multimodal vision fallback in the scan pipeline.
# OCR.Space is the only OCR engine; set true only if Gemini should be
# re-armed as a post-OCR enrichment pass.
ENABLE_VISION_FALLBACK=false
# Primary Gemini Vision extraction: when true, Gemini analyses the actual
# image and returns structured product data directly, bypassing the
# OCR -> text-normalizer -> product-extractor path. Requires a valid
# GEMINI_API_KEY (Gemini API keys start with "AIza").
GEMINI_PRIMARY_ENABLED=false
# Third-party OCR engine (used when configured; falls back to Tesseract).
OCR_SPACE_API_KEY=
# Food-package detection confidence threshold (0.0-1.0). Detection failure
# never aborts a scan; it only informs downstream analysis.
FOOD_PACKAGE_CONFIDENCE_THRESHOLD=0.45
# Maximum accepted image payload (MiB) per uploaded scan image.
MAX_IMAGE_SIZE_MB=10
# Hard timeout (seconds) for each OCR.Space API call.
OCR_TIMEOUT_SECONDS=60