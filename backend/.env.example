SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:3000
# Optional on Windows when Tesseract is not available in PATH.
TESSERACT_CMD=
# Multimodal vision extraction (Gemini 3.6 Flash). Keys are never exposed
# to the frontend. Falls back to raw Tesseract OCR output / Gemini-from-text
# when the API call fails.
VISION_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
VISION_API_KEY=
VISION_MODEL=gemini-3.6-flash
VISION_TIMEOUT_SECONDS=30
# Primary Gemini Vision extraction: when true, Gemini reads the label image(s)
# directly and is the source of structured fields; Tesseract OCR remains the
# local fallback. Requires a valid GEMINI_API_KEY.
GEMINI_PRIMARY_ENABLED=true
# Legacy post-OCR Gemini enrichment pass. Redundant when GEMINI_PRIMARY_ENABLED
# is true; keep false.
ENABLE_VISION_FALLBACK=false
# Local OCR engine used for per-side text/regions and the fallback pipeline.
# Optional on Windows when Tesseract is not in PATH: TESSERACT_CMD=
# Deprecated legacy third-party OCR key (no longer used by the pipeline).
OCR_SPACE_API_KEY=
# Food-package detection confidence threshold (0.0-1.0). Detection failure
# never aborts a scan; it only informs downstream analysis.
FOOD_PACKAGE_CONFIDENCE_THRESHOLD=0.45
# Maximum accepted image payload (MiB) per uploaded scan image.
MAX_IMAGE_SIZE_MB=10
# Hard timeout (seconds) for each OCR call.
OCR_TIMEOUT_SECONDS=60