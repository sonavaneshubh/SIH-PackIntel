SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:3000
# Optional on Windows when Tesseract is not available in PATH.
TESSERACT_CMD=
# Multimodal vision extraction (Gemini 2.5 Flash). Keys are never exposed
# to the frontend. Falls back to raw OCR output when the API call fails.
VISION_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
VISION_API_KEY=
VISION_MODEL=gemini-2.5-flash
VISION_TIMEOUT_SECONDS=30